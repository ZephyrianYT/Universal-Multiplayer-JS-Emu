PORT=8080
# Players make local accounts in their browser (no password, nothing stored on the server).
# Each host sets their own lobby password. Everything below is optional.
# The launcher (launch.bat / launch.sh) creates a .env with a random ADMIN_PASSWORD on first run.

ADMIN_PASSWORD=           # owner: "Unlock library" in the hub with this (8+ characters; placeholders are ignored)
# ADMIN_KEYS=             # or list owner account IDs (comma-separated, shown as #XXXX-XXXX-... in the top bar)
# ACCESS_PASSWORD=        # server-wide access code asked once per account; empty = anyone with the link.
                          # Recommended when the hub is on the internet (Cloudflare Tunnel, reverse proxy).
# LIBRARY_ACCESS=admin    # "all" lets every account use the library too
# SESSION_SECRET=         # optional; default is a random key saved next to the core cache
MAX_PLAYERS=4
# ROMS_DIR=./roms         # bare-metal only; the container uses /roms
# CORES_CACHE=./cache/cores

# ---- Native emulators (PS2 / GameCube / Wii / PS3 / Xbox / Xbox 360 / Wii U / 3DS / DS / GBA link; see emulators/README.md)
# EMULATORS_DIR=./emulators   # portable emulator builds, one folder per emulator
# NATIVE_PYTHON=python        # Python that runs the guest-controller bridge (launch.py passes its own)
# NATIVE_INPUT=auto           # guest controllers: auto | gamepad (vgamepad/ViGEmBus, evdev) | keyboard (Windows,
#                             # no installs; layout in emulators/KEYBOARD.md)

# ---- Internet play
# PUBLIC_URL=https://play.example.com   # your hub's public address; invite links use it.
#                                       # the window's Internet (Cloudflare Tunnel) option / --tunnel sets it for you on quick tunnels.
# TUNNEL_TOKEN=           # Cloudflare named tunnel token (Zero Trust > Networks > Tunnels). With it,
#                         # --tunnel / the compose "tunnel" profile use your own hostname; set PUBLIC_URL too.
# TRUST_PROXY=1           # trust X-Forwarded-For / CF-Connecting-IP from a proxy on ANOTHER machine or
#                         # container. Not needed when the proxy (cloudflared) runs on this computer.
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=user
# TURN_CREDENTIAL=secret

# ---- Lobbies across hubs (core/net/discovery.mjs)
# LAN_DISCOVERY=1         # 0 = don't send or listen for LAN lobby beacons (UDP 239.255.43.21:37115)
# MASTER_SERVER_URL=      # https://pool.example: list this hub's lobbies in a shared pool (needs PUBLIC_URL)
# MASTER_SERVER=0         # 1 = this hub is a master pool for other hubs (/api/master/heartbeat, /api/master/lobbies)
# LINK_PORT=5738          # GBA link cable (VBA-M) network port; allow VBA-M through the firewall

# ---- Updates (Retro Hub window > Server > Check for updates; setup/update.py)
# UPDATE_CHECK=on         # off = do not look for a new release when the window opens
# UPDATE_REPO=            # GitHub owner/repo to update from. Empty = ZephyrianYT/Universal-Multiplayer-JS-Emu
